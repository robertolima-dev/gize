use sqlx::PgPool;

use super::dto::{CreateProduct, Page, UpdateProduct};
use super::error::Error;
use super::model::Product;
use super::repository;

/// One page of `products` plus the total row count (ADR-022). `page` is 1-based.
pub async fn list(pool: &PgPool, page: u32, per_page: u32) -> Result<Page<Product>, Error> {
    let offset = i64::from(page - 1) * i64::from(per_page);
    let items = repository::list(pool, i64::from(per_page), offset)
        .await
        .map_err(Error::from)?;
    let total = repository::count(pool).await.map_err(Error::from)?;
    Ok(Page {
        items,
        page,
        per_page,
        total: u64::try_from(total).unwrap_or_default(),
    })
}

pub async fn find(pool: &PgPool, id: uuid::Uuid) -> Result<Product, Error> {
    repository::find(pool, id).await.map_err(Error::from)
}

pub async fn create(pool: &PgPool, input: &CreateProduct) -> Result<Product, Error> {
    repository::create(pool, input).await.map_err(Error::from)
}

pub async fn update(
    pool: &PgPool,
    id: uuid::Uuid,
    input: &UpdateProduct,
) -> Result<Product, Error> {
    repository::update(pool, id, input).await.map_err(Error::from)
}

pub async fn delete(pool: &PgPool, id: uuid::Uuid) -> Result<(), Error> {
    repository::delete(pool, id).await.map_err(Error::from)
}
